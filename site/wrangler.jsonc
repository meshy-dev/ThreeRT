// Deploy: bun site/tools/deploy.ts (builds out/site, then wrangler deploy with this file).
{
  "name": "threert-site",
  // The Cloudflare account that holds the threert.dev zone.
  "account_id": "5e97b4b91f8abaf2de54de9f866bfcae",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../out/site",
    "binding": "ASSETS",
    // The worker runs first so www can redirect; it hands every other request to the assets.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "threert.dev", "custom_domain": true },
    { "pattern": "www.threert.dev", "custom_domain": true }
  ],
  "workers_dev": false
}
