{
  "keyframes": {
    "menu": { "0%": { "opacity": 0, "transform": "translateY(-6px) scale(0.97)" }, "100%": { "opacity": 1, "transform": "translateY(0px) scale(1)" } },
    "fade": { "0%": { "opacity": 0 }, "100%": { "opacity": 1 } },
    "rise": { "0%": { "opacity": 0, "transform": "translateY(6px)" }, "100%": { "opacity": 1, "transform": "translateY(0px)" } },
    "drop": { "0%": { "opacity": 0, "transform": "translateY(-8px)" }, "100%": { "opacity": 1, "transform": "translateY(0px)" } },
    "tick": { "0%": { "opacity": 0, "transform": "scale(0.4)" }, "100%": { "opacity": 1, "transform": "scale(1)" } },
    "breathe": { "0%,100%": { "opacity": 1 }, "50%": { "opacity": 0.35 } }
  },
  "animation": {
    "menu": "menu 150ms cubic-bezier(0.2, 0, 0, 1) both",
    "fade": "fade 180ms ease-out both",
    "rise": "rise 240ms cubic-bezier(0.2, 0, 0, 1) both",
    "drop": "drop 220ms cubic-bezier(0.2, 0, 0, 1) both",
    "tick": "tick 180ms cubic-bezier(0.34, 1.56, 0.64, 1) both",
    "breathe": "breathe 1.4s ease-in-out infinite"
  }
}
