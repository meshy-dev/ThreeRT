{
  "id": "daylight-home",
  "industry": "Architecture & real estate",
  "title": "Daylight Home",
  "caption": "One living room, from morning sun to lamplight",
  "blurb": "A living room with a window wall, lit only by a physical sun and sky and, at night, by its two lamps. Step through the day and the patch of sun crosses the parquet, bounces onto the ceiling and takes the colour of whatever paint you choose: what a buyer wants to know, and what engines normally bake once.",
  "controls": [
    {
      "input": "T, or click the floor",
      "does": "morning, noon, golden hour, night"
    },
    {
      "input": "P, or click a wall",
      "does": "repaints the walls"
    },
    {
      "input": "F, or click the sofa",
      "does": "changes the sofa’s fabric"
    },
    {
      "input": "V",
      "does": "moves to another viewpoint"
    },
    {
      "input": "L, or click a lamp",
      "does": "switches the lamps"
    }
  ],
